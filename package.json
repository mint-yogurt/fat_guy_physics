{
  "name": "fatguyphysics",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev --workspace @fgp/client",
    "build": "npm run build --workspace @fgp/client",
    "preview": "npm run preview --workspace @fgp/client",
    "synth": "npm run dev --workspace @fgp/synth",
    "typecheck": "tsc --build --force && tsc -p packages/client/tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
